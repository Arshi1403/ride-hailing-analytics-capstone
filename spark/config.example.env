# Used only by `python -m ridespark.submit` to print the submission command. No credentials here:
# the batch runs as DATAPROC_SERVICE_ACCOUNT and your gcloud login is used to submit.
GCP_PROJECT_ID=labs-507309
GCP_REGION=asia-south1
BQ_RAW_DATASET=raw_ds
BQ_STREAM_TABLE=rides_stream
BQ_HIST_TABLE=rides_history

SPARK_RUNTIME_VERSION=2.2
SPARK_MAIN_URI=gs://REPLACE_ME_BUCKET/spark/code/run_job.py
SPARK_PY_FILES_URI=gs://REPLACE_ME_BUCKET/spark/code/ridespark.zip
DATAPROC_DEPS_BUCKET=gs://REPLACE_ME_BUCKET
DATAPROC_SERVICE_ACCOUNT=REPLACE_ME@labs-507309.iam.gserviceaccount.com
# Subnet needs Private Google Access. Optional; omit to use the default network.
# DATAPROC_SUBNET=default

# Job inputs and outputs
SPARK_OUTPUT_PATH=gs://REPLACE_ME_BUCKET/curated
SPARK_ZONES_INPUT=gs://REPLACE_ME_BUCKET/reference/taxi_zone_lookup.csv
# Optional until a driver source exists:
# SPARK_DRIVER_SNAPSHOT=gs://REPLACE_ME_BUCKET/drivers/snapshot.parquet
# Zone for pickup_date, weekday and hour_bucket. Confirm with the orchestrator.
SPARK_TIMEZONE=UTC
