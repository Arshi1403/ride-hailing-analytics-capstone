# Environment variables for the ride_hailing_daily DAG. Set them on the Composer environment (never commit real values):
#   gcloud composer environments update <ENV> --location asia-south1 --update-env-variables=KEY=VALUE,KEY2=VALUE2
# Required
RH_LANDING_BUCKET=REPLACE_ME_landing_bucket
RH_CURATED_BUCKET=REPLACE_ME_curated_bucket
RH_ARTIFACTS_BUCKET=REPLACE_ME_artifacts_bucket
RH_SPARK_SERVICE_ACCOUNT=REPLACE_ME@labs-507309.iam.gserviceaccount.com

# Defaults shown. Change only when needed.
GCP_PROJECT_ID=labs-507309
GCP_REGION=asia-south1
# RH_BQ_LOCATION=asia-south1
# RH_GCP_CONN_ID=google_cloud_default

# Schedule: 01:00 in RH_SCHEDULE_TZ for the previous business day (leaves five hours before 06:00).
# RH_SCHEDULE_CRON=0 1 * * *
# RH_SCHEDULE_TZ=Asia/Kolkata
# Business time zone: must equal the Spark --timezone and the BigQuery @business_tz. Orchestrator decision pending (UTC vs IST).
# RH_BUSINESS_TZ=UTC

# Pickup dates recomputed on a normal day: run date minus this many days .. run date
# RH_LOOKBACK_DAYS=3
# Spark output folder prefix inside RH_CURATED_BUCKET, runtime and optional private subnet
# RH_CURATED_PREFIX=curated
# RH_SPARK_RUNTIME=2.2
# RH_SPARK_SUBNET=projects/labs-507309/regions/asia-south1/subnetworks/REPLACE_ME

# Historical dump: path inside the landing bucket, {ds} = run date. Set RH_HISTORICAL_DUMP_REQUIRED=false once the one-off load is done.
# RH_HISTORICAL_OBJECT_TEMPLATE=historical/{ds}/yellow_tripdata_2018_sample.csv
# RH_HISTORICAL_DUMP_REQUIRED=true

# Dimension sources (zone lookup defaults to gs://<landing>/reference/taxi_zone_lookup.csv). Driver snapshot is optional:
# without it the SCD2 steps are skipped and the stored driver history is used.
# RH_ZONES_URI=gs://REPLACE_ME/reference/taxi_zone_lookup.csv
# RH_DRIVER_SNAPSHOT_URI=gs://REPLACE_ME/drivers/snapshot.parquet
# RH_ALLOW_MISSING_DIMENSIONS=false

# Where the uploaded sql/ folder is mounted (gcloud composer environments storage data import --destination sql)
# RH_SQL_DIR=/home/airflow/gcs/data/sql
# Per-query cap in bytes (queries over the cap fail instead of billing). The capstone guardrail is 10 GB.
# RH_MAX_BYTES_BILLED=10000000000

# Alerts: e-mail needs Composer's SendGrid/SMTP e-mail configuration; the webhook connection id is the Secret Manager secret name suffix
# RH_ALERT_EMAILS=ops@example.com
# RH_ALERT_CONN_ID=rh_alert_webhook

# Forecast: weekly on this weekday (Monday=0) when the Variable rh_enable_bqml_retrain is "true"
# RH_RETRAIN_WEEKDAY=0
# RH_FORECAST_TRAIN_DAYS=56
# RH_FORECAST_TOP_N=10
# RH_FORECAST_MIN_RIDES=500
# RH_FORECAST_MIN_ACTIVE_HOURS=168
# RH_FORECAST_CONFIDENCE=0.9
