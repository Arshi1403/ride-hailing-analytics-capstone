# Set these in your shell (PowerShell: $env:NAME = "value"). No credentials belong here:
# authentication uses Application Default Credentials (gcloud auth application-default login).
# Defaults are proposals; confirm against discovery output before use.
GCP_PROJECT_ID=labs-507309
GCP_REGION=asia-south1
BQ_RAW_DATASET=raw_ds
BQ_STREAM_TABLE=rides_stream
BQ_HIST_TABLE=rides_history
# Optional; default is <BQ_STREAM_TABLE>_error_records
# BQ_DLQ_TABLE=rides_stream_error_records
PUBSUB_SUBSCRIPTION=rides-events-sub

# Needed only to print the Dataflow launch command
DATAFLOW_JOB_NAME=rides-pubsub-to-bq
DATAFLOW_MAX_WORKERS=2
DATAFLOW_TEMP_LOCATION=gs://REPLACE_ME_BUCKET/dataflow/temp
DATAFLOW_UDF_GCS_PATH=gs://REPLACE_ME_BUCKET/dataflow/udf/ride_event_udf.js
DATAFLOW_SERVICE_ACCOUNT=REPLACE_ME@labs-507309.iam.gserviceaccount.com
# Default: gs://dataflow-templates-<region>/latest/PubSub_Subscription_to_BigQuery
# DATAFLOW_TEMPLATE_PATH=

# Historical load. HIST_YEAR must stay 2018 (capstone requirement).
HIST_YEAR=2018
HIST_FILE_PATTERN=.*2018.*\.csv(\.gz)?$
